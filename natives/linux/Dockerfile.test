# syntax=docker/dockerfile:1
#
# Runs the integration tests against the native bundle on a machine with no Mapnik and none of its
# libraries installed, which is what a user of the natives jar has. Needs build/natives from the
# Dockerfile next to this one. Build from the repository root:
#
#   docker build -f natives/linux/Dockerfile.test [--build-arg PLATFORM=linux-aarch64] .
#
# The build fails if a test fails.

FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# A clean machine: fail now if Mapnik or PROJ is installed anywhere the dynamic loader would find it.
RUN if ldconfig -p | grep -E 'libmapnik|libproj\.so'; then echo "this image must not contain Mapnik or PROJ" >&2; exit 1; fi \
 && if command -v mapnik-config >/dev/null; then echo "mapnik-config must not be installed" >&2; exit 1; fi

ARG PLATFORM=linux-x86_64
COPY . /work
WORKDIR /work
RUN test -f build/natives/${PLATFORM}/MANIFEST
RUN ./gradlew --no-daemon integrationTest -PbundledNatives -PnativesPlatform=${PLATFORM}
