+// A client context that checks the server's certificate against the trusted certificates of the system, or of
+// the file named by SSL_CERT_FILE. Without this the connection is encrypted but the server is not authenticated.
+inline boost::asio::ssl::context mapnik_tiles_tls_context()
+{
+    boost::asio::ssl::context ctx{boost::asio::ssl::context::tlsv12_client};
+    ctx.set_default_verify_paths();
+    ctx.set_verify_mode(boost::asio::ssl::verify_peer);
+    return ctx;
+}
 #endif
 
