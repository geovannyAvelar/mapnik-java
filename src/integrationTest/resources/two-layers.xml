<?xml version="1.0" encoding="utf-8"?>
<Map srs="epsg:4326" background-color="white">
  <Style name="red">
    <Rule><PolygonSymbolizer fill="red"/></Rule>
  </Style>
  <Style name="blue">
    <Rule><PolygonSymbolizer fill="blue"/></Rule>
  </Style>
  <Layer name="big" srs="epsg:4326">
    <StyleName>red</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">square.geojson</Parameter>
    </Datasource>
  </Layer>
  <Layer name="small" srs="epsg:4326">
    <StyleName>blue</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">small.geojson</Parameter>
    </Datasource>
  </Layer>
</Map>
